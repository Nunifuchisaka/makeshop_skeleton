<%
const title = "特定商取引法";
const description = "";

%><!doctype html>
<html lang="ja" prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb#">
<head>
<{$module.head}>

<title><%- title %>｜<{$shop.name}></title>
<meta property="og:title" content="<%- title %>">
<meta name="description" content="<%- description %>">
<meta property="og:description" content="<%- description %>">
</head>
<body class="page-contract">
<{$module.body_top}>
<{$module.header}>

<div id="wrapper" class="wrapper_1">

  <main id="main-1">
    <{$module.search_1}>

    <nav class="breadcrumb_1" aria-label="パンくずリスト">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="<{$url.top}>" itemprop="item">
            <span itemprop="name">ホーム</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" aria-current="page">
            <%- title %>
          </span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </nav><!-- /.breadcrumb_1 -->

    <header class="header_5">
      <h1 class="header_5__h1">
        <%- title %>
      </h1>
    </header>

    <div class="table_4">
      <table>
        <tr>
          <th>販売業者の名称</th>
          <td><{$contract.dealer}></td>
        </tr>
        <tr>
          <th>販売責任者名</th>
          <td><{$contract.manager}></td>
        </tr>
        <tr>
          <th>販売業者の住所</th>
          <td><{$contract.address}></td>
        </tr>
        <tr>
          <th>販売業者の連絡先</th>
          <td>
            メールアドレス：<{$contract.mail}><br>
            電話番号：<{$contract.tel}>
          </td>
        </tr>
        <tr>
          <th>商品代金以外の必要料金</th>
          <td><{$contract.other_charge}></td>
        </tr>
        <tr>
          <th>申し込み有効期限</th>
          <td><{$contract.expire_app}></td>
        </tr>
        <tr>
          <th>不良品</th>
          <td><{$contract.defective}></td>
        </tr>
        <tr>
          <th>販売数量</th>
          <td><{$contract.amount}></td>
        </tr>
        <tr>
          <th>引き渡し時期</th>
          <td><{$contract.receive_date}></td>
        </tr>
        <tr>
          <th>お支払い方法</th>
          <td><{$contract.pay_method}></td>
        </tr>
        <tr>
          <th>お支払い期限</th>
          <td><{$contract.expire_pay}></td>
        </tr>
        <tr>
          <th>返品期限</th>
          <td><{$contract.expire_return}></td>
        </tr>
        <tr>
          <th>返品送料</th>
          <td><{$contract.return_charge}></td>
        </tr>
      </table>
    </div><!-- /.table_4 -->

  </main>
</div><!-- /#wrapper -->

<{$module.footer}>
</body>
</html>
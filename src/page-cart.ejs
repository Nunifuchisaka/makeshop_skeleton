<!doctype html>
<html lang="ja" prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb#">
<head>
<{$module.head}>

<title><{$page.title}></title>
<meta property="og:title" content="<{$page.title}>">
<meta name="description" content="<{$page.description}>">
<meta property="og:description" content="<{$page.description}>">
</head>
<body>
<{$module.body_top}>
<{$module.header}>

<div id="wrapper" class="wrapper_1">

  <main id="main-1">
    <{$module.search_1}>

    <nav class="breadcrumb_1" aria-label="パンくずリスト">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="<{$url.top}>" itemprop="item">
            <span itemprop="name">ホーム</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" aria-current="page">
            カートの中身
          </span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </nav><!-- /.breadcrumb_1 -->

    <section class="section_1">
      <h1 class="section_1__h1">
        <span class="icon_cart_1"></span>カートの中身
      </h1>
      <{if $cart.has_item}>

        <{if $cart.is_free_shipping_enabled}>
          <div class="paragraphs_4">
            <{if $cart.free_shipping_price == 0}>
              <p>今回のお買い物は<em>送料無料</em>となります</p>
            <{else}>
              <p>あと<em><{$cart.free_shipping_price|number_format}>円</em>で送料無料になります</p>
              <p><{$cart.free_shipping_message}></p>
            <{/if}>
          </div>
        <{/if}>

        <div class="paragraphs_4">
          <p>カート内の商品合計 ： <{$cart.total_quantity|number_format}>点　<em><{$cart.total_price|number_format}>円</em></p>
        </div>

        <div class="table_7">
          <table>
            <thead>
              <tr>
                <th class="is_no">No.</th>
                <th class="is_item">商品情報</th>
                <th class="is_price">価格（税込）</th>
                <th class="is_quantity">数量</th>
              </tr>
            </thead>
              <tbody>
                <{section name=i loop=$cart.list}>
                  <tr>
                    <td class="is_no">
                      <{$cart.list[i].num}>
                    </td>
                    <td class="is_item">
                      <div class="table_7__item">
                        <a href="<{$cart.list[i].url}>" class="eyecatch">
                          <{if $cart.list[i].selected_option.image_L}>
                            <img src="<{$cart.list[i].selected_option.image_L}>" alt="<{$cart.list[i].name|escape:html}>">
                          <{else}>
                            <img src="<{$cart.list[i].image_S}>" alt="<{$cart.list[i].name|escape:html}>">
                          <{/if}>
                        </a>
                        <div class="info">
                          <p class="title">
                            <a href="<{$cart.list[i].url}>">
                              <{$cart.list[i].name|escape:html}>
                            </a>
                          </p>
                          <!-- 商品オプション -->
                          <{if $cart.list[i].selected_option.has_item}>
                            <div class="option">
                              <{section name=j loop=$cart.list[i].selected_option.list}>
                                <p><{$cart.list[i].selected_option.list[j].title}>：<{$cart.list[i].selected_option.list[j].option_name}></p>
                              <{/section}>
                            </div>
                          <{/if}>
                          <!-- 獲得ポイント -->
                          <{if $shop.is_point_enabled}>
                            <!-- <p><{$cart.list[i].total_point|number_format}>ポイント獲得できます</p> -->
                          <{/if}>
                          <!-- 名入れ -->
                          <{if $cart.list[i].name_print.has_item}>
                            <div class="nameprint">
                              <{section name=j loop=$cart.list[i].name_print.list}>
                                <p>
                                  <{$cart.list[i].name_print.list[j].title}>
                                </p>
                                <p>
                                  <{$cart.list[i].name_print.list[j].name|escape|nl2br}>
                                </p>
                              <{/section}>
                            </div>
                          <{/if}>
                          <{if $cart.list[i].is_subscription && $cart.list[i].subscription_discount.has_item}>
                            <p>初回お届け合計：<{$cart.list[i].subscription_discount.initial_quantity}>個</p>
                            <div class="order-nth-detail-container accordion">
                              <div class="order-nth-detail-toggle" onclick="toggleOrderNthDetail(this)">
                                <span class="toggle-title">お届け回数ごとの設定（数量：1あたり）</span>
                                <span class="toggle-icon">▼</span>
                              </div>
                              <div class="order-nth-detail-content" style="display: none;">
                                <div class="order-nth-detail-scroll">
                                  <table class="order-nth-detail-table">
                                    <thead>
                                      <tr>
                                        <th>回数</th>
                                        <th>価格</th>
                                        <th>個数</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <{section name=k loop=$cart.list[i].subscription_discount.list}>
                                      <tr>
                                        <td><{$cart.list[i].subscription_discount.list[k].times}>回</td>
                                        <td><{$cart.list[i].subscription_discount.list[k].price|number_format}>円</td>
                                        <td><{$cart.list[i].subscription_discount.list[k].quantity}>個</td>
                                      </tr>
                                    <{/section}>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        <{/if}>
                      </div><!-- /.info -->
                    </div><!-- /.table_7__item -->
                  </td>
                  <td class="is_price">
                    <div>
                      <p class="price">
                        <{$cart.list[i].total_price|number_format}>円
                      </p>
                      <p class="unit-price">
                        単価：<{$cart.list[i].price|number_format}>円
                      </p>
                    </div>
                  </td>
                  <td class="is_quantity">
                    <div>
                      <input type="number" data-id="<{$cart.list[i].quantity_id}>" value="<{$cart.list[i].quantity}>" name="item-quantity" min="1" max="999">
                      <a class="update" href="<{$cart.list[i].quantity_url}>">数量変更</a>
                      <a class="delete" href="<{$cart.list[i].remove_url}>">削除</a>
                    </div>
                  </td>
                </tr>
              <{/section}>
            </tbody>
          </table>
          <!-- 商品合計金額 -->
          <div class="table_7__total">
            <p class="price">
              <span>商品合計：</span>
              <span><em><{$cart.total_price|number_format}>円</em>（税込）</span>
            </p>
            <!-- <p class="point">
              <{$cart.total_point|number_format}>ポイント獲得できます
            </p> -->
            <!--まとめ買い割引額-->
            <{if $cart.bulk.has_item}>
              <{section name=i loop=$cart.bulk.list}>
                <p class="bulk">
                  <{$cart.bulk.list[i].name}> 割引額：￥<{$cart.bulk.list[i].discount_price}>
                </p>
              <{/section}>
            <{/if}>
          </div><!-- /.table_7__total -->
          <div class="table_7__buttons">
            <p class="order">
              <a class="button_7 is_payment" href="<{$cart.order_url}>">決済画面に進む</a>
            </p>
            <{if $cart.is_estimate_enabled}>
              <p class="estimate">
                <a class="button_1" href="<{$cart.estimate_url}>">見積書を作成する</a>
              </p>
            <{/if}>
            <{if $amazonpay.is_enabled}>
              <div class="amazon">
                <{$amazonpay.button_html}>
              </div>
            <{/if}>
            <p class="back">
              <a class="button_10" href="<{$url.top}>">ショッピングを続ける</a>
            </p>
          </div><!-- /.table_7__buttons -->
        </div><!-- /.table_7 -->
      <{else}>
        <div class="paragraphs_4">
          <p>カートに商品はありません</p>
        </div>
        <div class="table_7">
          <div class="table_7__buttons">
            <p class="back">
              <a class="button_10" href="<{$url.top}>">ショッピングを続ける</a>
            </p>
          </div><!-- /.table_7__buttons -->
        </div><!-- /.table_7 -->
      <{/if}>
    </section><!-- /.section_1 -->

    <{$module.checked}>
    <%- include("assets/html/_recommend") %>
    
  </main>
</div><!-- /#wrapper -->

<{$module.footer}>
</body>
</html>